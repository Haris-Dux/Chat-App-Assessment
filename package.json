{
  "name": "concierge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @concierge/contracts build && pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @concierge/contracts build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @concierge/api db:generate",
    "db:migrate": "pnpm --filter @concierge/api db:migrate",
    "db:seed": "pnpm --filter @concierge/api db:seed"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
