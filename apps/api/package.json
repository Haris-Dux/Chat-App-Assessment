{
  "name": "@concierge/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "database"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "oxlint --type-aware src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/database/tasks.ts migrate",
    "db:seed": "node --env-file-if-exists=.env src/database/tasks.ts seed"
  },
  "dependencies": {
    "@concierge/contracts": "workspace:*",
    "@date-fns/tz": "^1.5.0",
    "@mistralai/mistralai": "^2.7.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.1.2",
    "argon2": "^0.45.1",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.3",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pino-pretty": "^13.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
